<%- include("../partials/top", { title }) %>

<div class="flex items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Edit employee</h1>
    <p class="mt-1 text-sm text-slate-600">Update employee details.</p>
  </div>
  <a class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium hover:bg-slate-50" href="/employees/<%= employee.id %>">
    Back
  </a>
</div>

<div class="mt-5 rounded-xl border bg-white p-6 shadow-sm">
  <form method="post" action="/employees/<%= employee.id %>?_method=PUT">
    <%- include("_form", { employee, departments, roles }) %>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <button class="rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800" type="submit">
          Save changes
        </button>
        <a class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium hover:bg-slate-50" href="/employees/<%= employee.id %>">
          Cancel
        </a>
      </div>
    </div>
  </form>

  <div class="mt-3">
    <form method="post" action="/employees/<%= employee.id %>?_method=DELETE" onsubmit="return confirm('Delete this employee?');">
      <button class="rounded-lg border border-rose-300 bg-rose-50 px-4 py-2.5 text-sm font-medium text-rose-800 hover:bg-rose-100" type="submit">
        Delete employee
      </button>
    </form>
  </div>
</div>

<%- include("../partials/bottom") %>

