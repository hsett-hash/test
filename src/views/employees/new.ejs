<%- include("../partials/top", { title }) %>

<div class="flex items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Add employee</h1>
    <p class="mt-1 text-sm text-slate-600">Create a new employee record.</p>
  </div>
  <a class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium hover:bg-slate-50" href="/employees">
    Back
  </a>
</div>

<div class="mt-5 rounded-xl border bg-white p-6 shadow-sm">
  <form method="post" action="/employees">
    <%- include("_form", { employee, departments, roles }) %>

    <div class="mt-6 flex items-center gap-2">
      <button class="rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800" type="submit">
        Create
      </button>
      <a class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium hover:bg-slate-50" href="/employees">
        Cancel
      </a>
    </div>
  </form>
</div>

<%- include("../partials/bottom") %>

